<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BizFinder — Digital Business Directory</title>
<style>
:root{--navy:#142b4a;--blue:#2563eb;--light:#f4f7fb;--ink:#182230;--muted:#64748b;--line:#e3eaf3;--white:#fff;--green:#12805c}
*{box-sizing:border-box}body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;background:var(--light);color:var(--ink)}
button,input,select,textarea{font:inherit}button{cursor:pointer}.topbar{height:72px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 max(5%,calc((100% - 1200px)/2));gap:20px;position:sticky;top:0;z-index:5}
.brand{display:flex;align-items:center;gap:10px;font-weight:800;font-size:21px;color:var(--navy);white-space:nowrap}.brand-icon{display:grid;place-items:center;background:var(--blue);color:white;width:38px;height:38px;border-radius:12px;font-size:20px}
.nav{display:flex;gap:24px;align-items:center}.nav a{color:#475569;text-decoration:none;font-size:14px;font-weight:600}.nav a:hover{color:var(--blue)}
.btn{border:0;border-radius:10px;padding:11px 16px;font-weight:700;transition:.15s}.btn-primary{background:var(--blue);color:white}.btn-primary:hover{background:#1d4ed8}.btn-outline{background:white;border:1px solid #d5dfed;color:var(--navy)}.btn-soft{background:#eaf1ff;color:#1d4ed8}.btn-danger{background:#fff0f0;color:#b42318}.hero{background:linear-gradient(115deg,#102748,#1d4f91);color:white;padding:62px 22px 72px}.hero-inner{max-width:1100px;margin:auto}.eyebrow{text-transform:uppercase;letter-spacing:2px;font-size:11px;font-weight:800;color:#a9caff}.hero h1{font-size:clamp(34px,5vw,54px);line-height:1.08;max-width:690px;margin:15px 0}.hero p{color:#d4e3fa;font-size:17px;max-width:600px;line-height:1.65;margin-bottom:28px}
.searchbox{background:white;border-radius:16px;padding:12px;display:grid;grid-template-columns:1.5fr 1fr 1fr auto;gap:8px;box-shadow:0 18px 40px #07172c38;max-width:1000px}.searchfield{display:flex;align-items:center;gap:9px;padding:0 12px;border-right:1px solid var(--line)}.searchfield span{font-size:18px}.searchfield input,.searchfield select{width:100%;border:0;outline:0;padding:12px 0;color:var(--ink);background:white;min-width:0}.searchbox button{padding:14px 25px}
main{max-width:1100px;margin:0 auto;padding:34px 22px 70px}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:-54px;position:relative;margin-bottom:38px}.stat{background:white;border:1px solid var(--line);box-shadow:0 8px 25px #142b4a0c;border-radius:14px;padding:20px 22px}.stat strong{display:block;font-size:27px;color:var(--navy)}.stat span{color:var(--muted);font-size:13px}
.section-head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin:25px 0 20px}.section-head h2{margin:0;color:var(--navy);font-size:26px}.section-head p{margin:7px 0 0;color:var(--muted);font-size:14px}.categories{display:grid;grid-template-columns:repeat(6,1fr);gap:12px;margin-bottom:36px}.cat{background:white;border:1px solid var(--line);border-radius:13px;padding:17px 10px;text-align:center;color:var(--navy);font-weight:700;font-size:13px}.cat:hover,.cat.active{border-color:#8db1ff;background:#edf4ff;color:#1d4ed8}.cat .emoji{display:block;font-size:25px;margin-bottom:8px}
.listing-tools{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:17px}.result-count{font-size:14px;color:var(--muted)}.sort{padding:10px;border:1px solid var(--line);background:white;border-radius:9px;color:#475569}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.card{background:white;border:1px solid var(--line);border-radius:16px;overflow:hidden;transition:.2s;display:flex;flex-direction:column}.card:hover{transform:translateY(-3px);box-shadow:0 12px 28px #132b4a10}.card-top{height:112px;padding:20px;display:flex;align-items:center;justify-content:space-between;background:linear-gradient(120deg,#eaf2ff,#f8fbff)}.logo{width:62px;height:62px;border-radius:16px;display:grid;place-items:center;background:white;box-shadow:0 3px 12px #142b4a12;font-size:29px}.tag{background:#fff;color:#2563eb;border:1px solid #d8e6ff;border-radius:100px;padding:6px 10px;font-size:11px;font-weight:800}.card-body{padding:18px;display:flex;flex-direction:column;flex:1}.card h3{font-size:18px;margin:0 0 8px;color:var(--navy)}.desc{font-size:13px;line-height:1.55;color:var(--muted);margin:0 0 15px;min-height:40px}.meta{display:flex;gap:8px;font-size:13px;color:#526176;margin:5px 0;align-items:flex-start}.meta span:first-child{width:17px}.card-foot{display:flex;justify-content:space-between;align-items:center;border-top:1px solid #edf1f7;margin-top:15px;padding-top:14px}.link{color:var(--blue);text-decoration:none;font-size:13px;font-weight:800}.card-actions{display:flex;gap:6px}.icon-btn{border:1px solid var(--line);background:#fff;border-radius:8px;padding:6px 8px;font-size:12px;color:#526176}
.empty{grid-column:1/-1;text-align:center;padding:50px 20px;background:#fff;border:1px dashed #cbd5e1;border-radius:16px;color:var(--muted)}.empty b{display:block;color:var(--navy);font-size:19px;margin-bottom:7px}
footer{background:#102748;color:#d6e2f3;padding:28px 22px;text-align:center;font-size:13px}.footer-inner{max-width:1100px;margin:auto;display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}
.adminbar{background:#fff7e6;border-bottom:1px solid #f4d9a1;padding:9px 22px;text-align:center;color:#805b12;font-size:13px;display:none}.adminbar.show{display:block}
.modal-backdrop{position:fixed;inset:0;background:#0b1c33a6;z-index:20;display:none;align-items:center;justify-content:center;padding:18px}.modal-backdrop.open{display:flex}.modal{background:white;border-radius:18px;width:min(620px,100%);max-height:92vh;overflow:auto;box-shadow:0 24px 80px #0003}.modal-head{display:flex;justify-content:space-between;align-items:center;padding:21px 24px;border-bottom:1px solid var(--line)}.modal-head h2{margin:0;color:var(--navy);font-size:21px}.close{border:0;background:#f1f5f9;border-radius:8px;padding:7px 11px;font-size:19px}.form{padding:22px 24px;display:grid;grid-template-columns:1fr 1fr;gap:15px}.field{display:flex;flex-direction:column;gap:7px}.field.full{grid-column:1/-1}.field label{font-size:12px;font-weight:800;color:#526176}.field input,.field select,.field textarea{border:1px solid #d9e2ee;border-radius:9px;padding:11px 12px;outline:0;background:#fff;color:var(--ink)}.field input:focus,.field select:focus,.field textarea:focus{border-color:#80aaff;box-shadow:0 0 0 3px #2563eb15}.form-actions{grid-column:1/-1;display:flex;justify-content:flex-end;gap:9px;padding-top:6px}.toast{position:fixed;bottom:22px;right:22px;background:#12345b;color:white;padding:14px 18px;border-radius:12px;box-shadow:0 8px 25px #0002;z-index:40;display:none;max-width:90vw}.toast.show{display:block;animation:pop .2s}@keyframes pop{from{transform:translateY(8px);opacity:0}to{transform:translateY(0);opacity:1}}
.detail-grid{display:grid;grid-template-columns:100px 1fr;gap:18px;padding:24px}.detail-logo{width:90px;height:90px;display:grid;place-items:center;font-size:42px;background:#edf4ff;border-radius:20px}.detail-grid h3{margin:0 0 8px;color:var(--navy);font-size:23px}.detail-grid p{color:var(--muted);line-height:1.6}.detail-list{padding:0 24px 24px}.detail-list .meta{padding:7px 0}
@media(max-width:800px){.nav{gap:12px}.nav a:not(:first-child){display:none}.searchbox{grid-template-columns:1fr 1fr}.searchfield{border:1px solid var(--line);border-radius:8px}.searchbox button{grid-column:1/-1}.categories{grid-template-columns:repeat(3,1fr)}.grid{grid-template-columns:repeat(2,1fr)}.stats{margin-top:-42px}}
@media(max-width:540px){.topbar{padding:0 16px;height:64px}.brand{font-size:18px}.nav .btn{padding:9px 11px;font-size:12px}.hero{padding:43px 18px 62px}.hero p{font-size:15px}.searchbox{grid-template-columns:1fr}.searchbox button{grid-column:auto}.stats{grid-template-columns:1fr;margin-top:-38px;gap:9px}.stat{padding:13px 16px}.stat strong{font-size:22px}.categories{grid-template-columns:repeat(2,1fr)}main{padding:25px 16px 50px}.grid{grid-template-columns:1fr}.section-head{align-items:flex-start}.form{grid-template-columns:1fr}.field.full,.form-actions{grid-column:auto}.detail-grid{grid-template-columns:1fr}.footer-inner{justify-content:center}}
</style>
</head>
<body>
<div class="adminbar" id="adminbar">Demo Admin Mode is ON — changes are saved in this browser only, not in MongoDB.</div>
<header class="topbar">
  <div class="brand"><span class="brand-icon">⌘</span> BizFinder</div>
  <nav class="nav"><a href="#home">Home</a><a href="#categories">Categories</a><a href="#businesses">Explore</a><button class="btn btn-outline" id="adminToggle" onclick="toggleAdmin()">Admin Demo: Off</button></nav>
</header>
<section class="hero" id="home"><div class="hero-inner">
  <div class="eyebrow">YOUR LOCAL DISCOVERY PLATFORM</div>
  <h1>Find the right business.<br>Right around you.</h1>
  <p>Explore trusted local services, discover new places, and connect with businesses in your city.</p>
  <form class="searchbox" id="searchForm">
    <label class="searchfield"><span>⌕</span><input id="searchInput" placeholder="Business name or keyword" aria-label="Search business"></label>
    <label class="searchfield"><span>▦</span><select id="categoryFilter" aria-label="Category"><option value="">All categories</option></select></label>
    <label class="searchfield"><span>⌖</span><input id="locationFilter" placeholder="City or location" aria-label="Location"></label>
    <button class="btn btn-primary" type="submit">Search businesses →</button>
  </form>
</div></section>
<main>
  <section class="stats">
    <div class="stat"><strong id="businessCount">12</strong><span>Listed businesses</span></div>
    <div class="stat"><strong id="categoryCount">6</strong><span>Business categories</span></div>
    <div class="stat"><strong>24/7</strong><span>Discover anytime</span></div>
  </section>
  <section id="categories"><div class="section-head"><div><h2>Browse by category</h2><p>Start exploring the services you need.</p></div></div><div class="categories" id="categoryTiles"></div></section>
  <section id="businesses"><div class="section-head"><div><h2>Explore businesses</h2><p>Find a business that fits your needs.</p></div><button class="btn btn-primary" id="addBusinessBtn" onclick="openForm()" style="display:none">＋ Add business</button></div>
    <div class="listing-tools"><div class="result-count" id="resultCount">Showing all businesses</div><select class="sort" id="sortSelect" aria-label="Sort businesses"><option value="name">Sort: Name A–Z</option><option value="newest">Sort: Recently added</option></select></div>
    <div class="grid" id="businessGrid"></div>
  </section>
</main>
<footer><div class="footer-inner"><span><b>BizFinder</b> · Digital Business Directory Prototype</span><span>Built to demonstrate business search, categories and CRUD workflows.</span></div></footer>

<div class="modal-backdrop" id="formBackdrop" role="dialog" aria-modal="true" aria-labelledby="formTitle"><div class="modal">
  <div class="modal-head"><h2 id="formTitle">Add a business</h2><button class="close" onclick="closeForm()" aria-label="Close">×</button></div>
  <form class="form" id="businessForm">
    <input type="hidden" id="editId">
    <div class="field"><label for="name">Business name *</label><input id="name" required maxlength="100" placeholder="e.g. Bluebird Cafe"></div>
    <div class="field"><label for="category">Category *</label><select id="category" required></select></div>
    <div class="field"><label for="location">City / Location *</label><input id="location" required placeholder="e.g. Hyderabad"></div>
    <div class="field"><label for="contact">Contact number *</label><input id="contact" required placeholder="e.g. Demo contact"></div>
    <div class="field full"><label for="website">Website (optional)</label><input id="website" placeholder="https://example.com"></div>
    <div class="field full"><label for="description">Description *</label><textarea id="description" rows="3" required placeholder="What does this business offer?"></textarea></div>
    <div class="form-actions"><button type="button" class="btn btn-outline" onclick="closeForm()">Cancel</button><button type="submit" class="btn btn-primary">Save business</button></div>
  </form>
</div></div>
<div class="modal-backdrop" id="detailBackdrop" role="dialog" aria-modal="true"><div class="modal"><div class="modal-head"><h2>Business details</h2><button class="close" onclick="closeDetails()">×</button></div><div id="detailContent"></div></div></div>
<div class="toast" id="toast" role="status"></div>
<script>
const categoryInfo=[
 {name:"Restaurants",icon:"🍽️"},{name:"IT Services",icon:"💻"},{name:"Healthcare",icon:"🩺"},{name:"Education",icon:"🎓"},{name:"Shopping",icon:"🛍️"},{name:"Hotels",icon:"🛎️"}
];
const starter=[
 {id:"b1",name:"Copper Kettle Cafe",category:"Restaurants",location:"Hyderabad",contact:"Demo contact · 000-000-0101",website:"https://example.com",description:"A cozy cafe concept serving coffee, light meals, and freshly baked treats.",icon:"☕"},
 {id:"b2",name:"PixelCraft Technologies",category:"IT Services",location:"Hyderabad",contact:"Demo contact · 000-000-0102",website:"https://example.com",description:"A sample technology company offering web development and digital solutions.",icon:"💻"},
 {id:"b3",name:"GreenLeaf Family Clinic",category:"Healthcare",location:"Vijayawada",contact:"Demo contact · 000-000-0103",website:"",description:"A sample clinic listing for general consultations and family wellness.",icon:"🩺"},
 {id:"b4",name:"BrightPath Academy",category:"Education",location:"Guntur",contact:"Demo contact · 000-000-0104",website:"https://example.com",description:"A learning center concept with academic support and skill-building courses.",icon:"📚"},
 {id:"b5",name:"Urban Nest Boutique",category:"Shopping",location:"Visakhapatnam",contact:"Demo contact · 000-000-0105",website:"https://example.com",description:"A boutique concept featuring gifts, accessories, and lifestyle products.",icon:"🛍️"},
 {id:"b6",name:"Skyline Stay Hotel",category:"Hotels",location:"Hyderabad",contact:"Demo contact · 000-000-0106",website:"https://example.com",description:"A sample hotel listing for comfortable stays and guest services.",icon:"🏨"},
 {id:"b7",name:"Spice Route Kitchen",category:"Restaurants",location:"Warangal",contact:"Demo contact · 000-000-0107",website:"",description:"A restaurant concept celebrating regional flavors and family dining.",icon:"🍛"},
 {id:"b8",name:"CloudNine Systems",category:"IT Services",location:"Bengaluru",contact:"Demo contact · 000-000-0108",website:"https://example.com",description:"A sample IT services listing for cloud, software, and support solutions.",icon:"☁️"},
 {id:"b9",name:"Little Steps Learning",category:"Education",location:"Hyderabad",contact:"Demo contact · 000-000-0109",website:"",description:"A sample education provider focused on foundational learning.",icon:"✏️"},
 {id:"b10",name:"CareSpring Wellness",category:"Healthcare",location:"Chennai",contact:"Demo contact · 000-000-0110",website:"https://example.com",description:"A sample wellness service listing for preventive care and wellbeing.",icon:"🌿"},
 {id:"b11",name:"Everyday Essentials",category:"Shopping",location:"Vijayawada",contact:"Demo contact · 000-000-0111",website:"",description:"A neighborhood shop concept for everyday household needs.",icon:"🧺"},
 {id:"b12",name:"Palm Grove Suites",category:"Hotels",location:"Visakhapatnam",contact:"Demo contact · 000-000-0112",website:"https://example.com",description:"A sample stay listing with guest accommodation and travel convenience.",icon:"🌴"}
];
let businesses=[];
try{const saved=localStorage.getItem("bizfinder-prototype-data");businesses=saved?JSON.parse(saved):starter.map(x=>({...x}));}catch(e){businesses=starter.map(x=>({...x}));}
let admin=false, activeCategory="";
function persist(){localStorage.setItem("bizfinder-prototype-data",JSON.stringify(businesses));}
function escapeHtml(s=""){return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));}
function categoryIcon(c){return (categoryInfo.find(x=>x.name===c)||{}).icon||"🏢";}
function fillSelects(){const opts=categoryInfo.map(c=>`<option value="${escapeHtml(c.name)}">${escapeHtml(c.name)}</option>`).join("");document.getElementById("categoryFilter").innerHTML='<option value="">All categories</option>'+opts;document.getElementById("category").innerHTML='<option value="">Choose category</option>'+opts;document.getElementById("categoryTiles").innerHTML=categoryInfo.map(c=>`<button class="cat ${activeCategory===c.name?"active":""}" onclick="pickCategory('${c.name}')"><span class="emoji">${c.icon}</span>${c.name}</button>`).join("");}
function render(){const q=document.getElementById("searchInput").value.trim().toLowerCase(),cat=document.getElementById("categoryFilter").value,loc=document.getElementById("locationFilter").value.trim().toLowerCase(),sort=document.getElementById("sortSelect").value;
let rows=businesses.filter(b=>(!q||[b.name,b.category,b.location,b.description].some(v=>(v||"").toLowerCase().includes(q)))&&(!cat||b.category===cat)&&(!loc||(b.location||"").toLowerCase().includes(loc))&&(!activeCategory||b.category===activeCategory));
rows.sort((a,b)=>sort==="newest"?(b.createdAt||0)-(a.createdAt||0):a.name.localeCompare(b.name));
document.getElementById("businessCount").textContent=businesses.length;document.getElementById("categoryCount").textContent=new Set(businesses.map(b=>b.category)).size;document.getElementById("resultCount").textContent=`Showing ${rows.length} of ${businesses.length} businesses`;
const grid=document.getElementById("businessGrid");
if(!rows.length){grid.innerHTML='<div class="empty"><b>No businesses found</b>Try another keyword, category, or location.</div>';return;}
grid.innerHTML=rows.map(b=>`<article class="card"><div class="card-top"><div class="logo">${escapeHtml(b.icon||categoryIcon(b.category))}</div><span class="tag">${escapeHtml(b.category)}</span></div><div class="card-body"><h3>${escapeHtml(b.name)}</h3><p class="desc">${escapeHtml(b.description)}</p><div class="meta"><span>⌖</span><span>${escapeHtml(b.location)}</span></div><div class="meta"><span>☎</span><span>${escapeHtml(b.contact)}</span></div><div class="card-foot"><button class="link" onclick="showDetails('${b.id}')">View details →</button><div class="card-actions">${admin?`<button class="icon-btn" onclick="editBusiness('${b.id}')">Edit</button><button class="icon-btn" onclick="deleteBusiness('${b.id}')">Delete</button>`:""}</div></div></div></article>`).join("");}
function pickCategory(c){activeCategory=activeCategory===c?"":c;document.getElementById("categoryFilter").value=activeCategory;fillSelects();render();document.getElementById("businesses").scrollIntoView({behavior:"smooth"});}
function toggleAdmin(){admin=!admin;document.getElementById("adminToggle").textContent=`Admin Demo: ${admin?"On":"Off"}`;document.getElementById("adminbar").classList.toggle("show",admin);document.getElementById("addBusinessBtn").style.display=admin?"inline-block":"none";render();if(admin)toast("Demo admin mode enabled. No login security is implemented in this prototype.");}
function openForm(b=null){if(!admin){toast("Turn on Admin Demo to manage listings.");return;}document.getElementById("businessForm").reset();document.getElementById("editId").value=b?b.id:"";document.getElementById("formTitle").textContent=b?"Edit business":"Add a business";if(b){["name","category","location","contact","website","description"].forEach(k=>document.getElementById(k).value=b[k]||"");}document.getElementById("formBackdrop").classList.add("open");}
function closeForm(){document.getElementById("formBackdrop").classList.remove("open");}
function editBusiness(id){const b=businesses.find(x=>x.id===id);if(b)openForm(b);}
function deleteBusiness(id){const b=businesses.find(x=>x.id===id);if(!b)return;if(confirm(`Delete "${b.name}" from this browser prototype?`)){businesses=businesses.filter(x=>x.id!==id);persist();render();toast("Business deleted from this prototype.");}}
document.getElementById("businessForm").addEventListener("submit",e=>{e.preventDefault();if(!admin)return;const id=document.getElementById("editId").value;const old=businesses.find(b=>b.id===id);const item={id:id||"b"+Date.now(),name:document.getElementById("name").value.trim(),category:document.getElementById("category").value,location:document.getElementById("location").value.trim(),contact:document.getElementById("contact").value.trim(),website:document.getElementById("website").value.trim(),description:document.getElementById("description").value.trim(),icon:old?.icon||categoryIcon(document.getElementById("category").value),createdAt:old?.createdAt||Date.now()};if(!/^https?:\/\//i.test(item.website)&&item.website)item.website="https://"+item.website;if(id)businesses=businesses.map(b=>b.id===id?item:b);else businesses.unshift(item);persist();closeForm();render();toast(id?"Business updated successfully.":"Business added successfully.");});
function showDetails(id){const b=businesses.find(x=>x.id===id);if(!b)return;document.getElementById("detailContent").innerHTML=`<div class="detail-grid"><div class="detail-logo">${escapeHtml(b.icon||categoryIcon(b.category))}</div><div><span class="tag">${escapeHtml(b.category)}</span><h3 style="margin-top:12px">${escapeHtml(b.name)}</h3><p>${escapeHtml(b.description)}</p></div></div><div class="detail-list"><div class="meta"><span>⌖</span><span><b>Location:</b> ${escapeHtml(b.location)}</span></div><div class="meta"><span>☎</span><span><b>Contact:</b> ${escapeHtml(b.contact)}</span></div><div class="meta"><span>↗</span><span><b>Website:</b> ${b.website?`<a class="link" href="${escapeHtml(b.website)}" target="_blank" rel="noopener noreferrer">${escapeHtml(b.website)}</a>`:"Not provided"}</span></div></div>`;document.getElementById("detailBackdrop").classList.add("open");}
function closeDetails(){document.getElementById("detailBackdrop").classList.remove("open");}
let toastTimer;function toast(msg){const el=document.getElementById("toast");el.textContent=msg;el.classList.add("show");clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove("show"),3200);}
document.getElementById("searchForm").addEventListener("submit",e=>{e.preventDefault();activeCategory="";fillSelects();render();document.getElementById("businesses").scrollIntoView({behavior:"smooth"});});
document.getElementById("categoryFilter").addEventListener("change",()=>{activeCategory="";fillSelects();document.getElementById("categoryFilter").value=document.getElementById("categoryFilter").value;render();});
document.getElementById("sortSelect").addEventListener("change",render);
document.getElementById("formBackdrop").addEventListener("click",e=>{if(e.target.id==="formBackdrop")closeForm();});
document.getElementById("detailBackdrop").addEventListener("click",e=>{if(e.target.id==="detailBackdrop")closeDetails();});
document.addEventListener("keydown",e=>{if(e.key==="Escape"){closeForm();closeDetails();}});
fillSelects();render();
</script>
</body>
</html>
